    "@radix-ui/react-slot": "^1.4.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint-config-prettier": "^10.1.8",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.54.0",
    "next": "15.5.9",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
