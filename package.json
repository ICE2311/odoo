    "db:reset:test": "tsx --env-file=.env src/server/db/reset-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:email": "tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
